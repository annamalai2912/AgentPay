# PayPal Developer Sandbox Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Optional: Google Gemini API Key for Enhanced Reasoning
# Get free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

